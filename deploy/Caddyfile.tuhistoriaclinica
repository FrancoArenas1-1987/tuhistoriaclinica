# Add this block to the existing Caddyfile only after DNS is configured.
tuhistoriaclinica.conectaproia.cl {
    request_body {
        max_size 14MB
    }
    encode gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    reverse_proxy tuhistoriaclinica:8000 {
        header_up X-Forwarded-For {remote_host}
    }
}
