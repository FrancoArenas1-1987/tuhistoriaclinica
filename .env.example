APP_NAME="TuHistoriaClinica.cl"
ENVIRONMENT="dev"
SECRET_KEY="reemplazar-por-una-clave-aleatoria"
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
DATABASE_URL="postgresql+psycopg://USUARIO:CLAVE@127.0.0.1:15432/tuhistoriaclinica"

# Automatic protections (no external services)
REGISTRATION_HOUR_LIMIT=5
REGISTRATION_DAY_LIMIT=20
REGISTRATION_SITE_HOUR_LIMIT=100
REGISTRATION_MIN_SECONDS=2
REGISTRATION_TOKEN_SECONDS=900
PATIENT_QUOTA=2000
VISIT_QUOTA=20000
APPOINTMENT_QUOTA=20000
MEDICAL_ORDER_COUNT_QUOTA=2000
MEDICAL_ORDER_QUOTA_MB=512

# Optional password recovery. Keep SMTP_PASSWORD in private .env only.
# PUBLIC_BASE_URL=https://tuhistoriaclinica.conectaproia.cl
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=remitente@gmail.com
# SMTP_FROM=remitente@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación
PASSWORD_RESET_MINUTES=15

# Enable only after SMTP delivery is verified.
PASSWORD_RECOVERY_ENABLED=false
